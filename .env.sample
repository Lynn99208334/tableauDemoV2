# ============================================================
# 本機開發環境變數範本
# 使用方式：cp .env.sample .env，然後填入實際值
# .env 已被 .gitignore 排除，不會 commit
# ============================================================

# === Profile ===
# 本機開發固定填 dev
SPRING_PROFILES_ACTIVE=dev

# === Encryption ===
# AES-256 加密 key（帳號、卡號等敏感欄位加密用）
# ⚠️ 必須與加密既有 DB 資料時使用的 key 一致，否則舊資料解不開
# 若是全新環境（DB 空的），可用此指令產生新 key：
#   openssl rand -base64 24 | cut -c1-32
ACCOUNT_NUMBER_ENCRYPTION_KEY=your-32-char-aes-key-here

# === Email（Resend HTTPS API）===
# 取得方式：Resend Dashboard → API Keys → Create API Key
# 若留空，寄信會失敗（log error）但不影響啟動
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ============================================================
# 以下變數本機 dev 不需要設定，皆有 fallback 或在 dev.properties 寫死：
#   DB_HOST / DB_USERNAME / DB_PASSWORD  → dev.properties 寫死 localhost/root/123456
#   JWT_SECRET / JWT_EXPIRATION          → dev.properties 寫死 dev 專用值
#   REDIS_URL                            → 預設 redis://localhost:6379
#   APP_BASE_URL                         → 預設 http://localhost:8111
# ============================================================
